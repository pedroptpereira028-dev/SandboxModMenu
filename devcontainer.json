{
  "name": "Android Sandbox Mod Menu",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:2": {
      "platforms": "35",
      "buildTools": "35.0.0",
      "cmdline-tools-version": "latest"
    }
  },
  "postCreateCommand": "chmod +x gradlew && yes | sdkmanager --licenses >/dev/null 2>&1 || true"
}
